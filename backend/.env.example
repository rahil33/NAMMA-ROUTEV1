PORT=8787
# Browser-visible origin of the frontend (Vite dev server in development).
PUBLIC_URL=http://localhost:5173
APP_URL=http://localhost:5173
# REQUIRED in production: 32+ random characters (openssl rand -hex 32). In dev a temporary one is used.
SESSION_SECRET=
# Development only: print OTP codes in this terminal instead of sending SMS. Ignored in production.
AUTH_DEV_OTP=true

# Google OAuth: add redirect URI  http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mobile OTP (Twilio Verify) and guardian SMS (Twilio Messaging)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Ride fares/ETAs (official API access required; otherwise deep links only)
UBER_SERVER_TOKEN=
# Public transport: OpenTripPlanner 2.x base URL with a GTFS feed you are licensed to use
OTP_URL=
CHENNAI_ONE_URL=
OSRM_URL=
DATA_DIR=
TRUST_PROXY=
